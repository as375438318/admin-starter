root = true

# 统一换行与缩进，避免 Windows/Linux 协作时每行都变（仓库已设 core.autocrlf=false + .gitattributes LF）
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,xml}]
indent_size = 4

[*.{yml,yaml,json,ts,tsx,js,mjs,cjs,vue,scss,css,html}]
indent_size = 2

[*.md]
# Markdown 行尾两个空格是换行语义，不能裁掉
trim_trailing_whitespace = false

[*.{sql,ps1}]
indent_size = 4
