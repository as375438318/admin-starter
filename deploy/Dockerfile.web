# 前端镜像：多阶段构建。产物是纯静态文件，由 nginx 托管并反代 /api 到后端容器。
#
# 为什么不用 Vite dev server 直接跑：dev server 有 HMR 与源码映射，不适合交付；
# 而且它的 /api 代理配置指向 127.0.0.1:8082，在容器里根本连不到后端。
#
# 构建：docker build -f deploy/Dockerfile.web -t admin-starter-web:local .

FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
# 先只拷清单，利用层缓存：改业务代码不必重装依赖
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/pc/package.json apps/pc/package.json
COPY apps/shared/package.json apps/shared/package.json
COPY packages/ui-tokens/package.json packages/ui-tokens/package.json
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter @admin-starter/pc build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/pc/dist /usr/share/nginx/html
EXPOSE 80
# nginx 官方镜像自带 SIGTERM 处理，无需额外 init