# 复制为 .env 后修改。.env 不提交（见 .gitignore）。
# 三个必填项：不填的话 docker compose 会直接报错（compose 里的 :? 语法）。

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=admin_starter
MYSQL_USER=admin_app
MYSQL_PASSWORD=change-me-app

# Redis
REDIS_PASSWORD=change-me-redis

# 站点对外地址与端口
WEB_PORT=80
# 后端写操作会校验 Origin（OriginCheckFilter）；与浏览器地址栏的协议+域名+端口保持一致
PUBLIC_ORIGIN=http://localhost